#!/usr/bin/env node
// Write assets/progress.js (window.PROGRESS = {...}), which feeds the dashboard on the landing page.
// Lessons published come from each course's assets/nav.js (the lesson registry).
// Study activity comes from the Neon DB (quiz / kata / lesson_completed / review
// events). Notes and lesson_generated rows are bookkeeping, not study, so they
// are left out.
// Works locally (creds from ~/.config/learning/db.env) and in CI (LEARNING_DB_URL env).
// Usage: bin/export-progress
const fs = require("fs");
const path = require("path");
const { execFileSync } = require("child_process");

const root = path.resolve(__dirname, "..");

let dbUrl = process.env.LEARNING_DB_URL;
if (!dbUrl) {
  const env = fs.readFileSync(path.join(process.env.HOME, ".config/learning/db.env"), "utf8");
  dbUrl = (env.match(/LEARNING_DB_URL=["']?([^"'\n]+)/) || [])[1];
}
if (!dbUrl) throw new Error("LEARNING_DB_URL not set and not found in ~/.config/learning/db.env");

// --- lessons published, per course -------------------------------------------
const courses = {};
for (const dir of fs.readdirSync(root)) {
  const navPath = path.join(root, dir, "assets/nav.js");
  if (!fs.existsSync(navPath)) continue;
  const src = fs.readFileSync(navPath, "utf8");
  const block = (src.match(/const LESSONS = \[([\s\S]*?)\n  \];/) || [])[1] || "";
  const live = block.split("\n").filter((l) => !l.trim().startsWith("//")).join("\n");
  const dates = [...live.matchAll(/date: "(\d{4}-\d{2}-\d{2})"/g)].map((m) => m[1]).sort();
  courses[dir] = {
    lessons: (live.match(/\bfile: "/g) || []).length,
    latest: dates[dates.length - 1] || null,
  };
}

// --- study activity, per day (learner's timezone) ----------------------------
const sql = `
  SELECT coalesce(json_agg(row_to_json(t) ORDER BY t.date, t.course), '[]')
  FROM (
    SELECT (recorded_at AT TIME ZONE 'Asia/Ho_Chi_Minh')::date::text AS date,
           course,
           count(*)::int AS events,
           count(*) FILTER (WHERE kind = 'quiz')::int AS quiz,
           count(*) FILTER (WHERE kind = 'quiz' AND detail->>'ok' = 'true')::int AS quiz_ok,
           array_agg(DISTINCT coalesce(lesson, 'day-' || day))
             FILTER (WHERE lesson IS NOT NULL OR day IS NOT NULL) AS lessons
    FROM course_progress
    WHERE kind IN ('quiz', 'kata', 'lesson_completed', 'review')
    GROUP BY 1, 2
  ) t;`;
const activity = JSON.parse(execFileSync("psql", [dbUrl, "-At", "-c", sql], { encoding: "utf8" }));

const out = {
  generated: new Date().toISOString(),
  courses,
  activity: activity.map((a) => ({ ...a, lessons: a.lessons || [] })),
};
// A script, not .json, so the landing page also works opened from disk (file:// blocks fetch).
fs.writeFileSync(
  path.join(root, "assets/progress.js"),
  "// Generated by bin/export-progress. Do not edit.\nwindow.PROGRESS = " + JSON.stringify(out, null, 1) + ";\n"
);
console.log(`progress.js: ${Object.keys(courses).length} courses, ${activity.length} activity rows`);
